{
  "name": "shellui-admin",
  "version": "0.9.1",
  "description": "Shellui admin panel — React app embedded in the main shell",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve:dist": "node tools/serve/serve.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:sdk": "pnpm -C ../shellui run build:sdk",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "pnpm exec prettier --write --ignore-unknown"
  },
  "author": "Shellui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shellui/shellui-admin.git"
  },
  "packageManager": "pnpm@10.30.0",
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/editor": "1.7.3",
    "@shellui/sdk": "0.7.0-alpha.8",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^24.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "6.11.3",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.1.1",
    "react-router": "^7.18.3",
    "react-router-dom": "^7.18.4",
    "simple-icons": "^14.15.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": ">=1.2.2",
      "happy-dom": ">=21.0.4"
    }
  }
}
