# Local dev only (Vite `import.meta.env`). Production Admin reads service URLs from the host shell.
# Copy to `.env` for `pnpm dev` / `pnpm start`, or set the same names in shellui/dev compose for the admin service.

# Shellui dev stack host ports (http://localhost:<port>):
# identity 8001, storage 8002, hosting 8003, email 8004, ai 8006, files 5175, admin 5173

VITE_IDENTITY_URL=http://localhost:8001
VITE_STORAGE_URL=http://localhost:8002
VITE_HOSTING_URL=http://localhost:8003
VITE_EMAIL_URL=http://localhost:8004
VITE_AI_SERVICE_URL=http://localhost:8006
# VITE_FILES_URL=http://localhost:5175

# Vite dev server (Docker publish + HMR through the host port)
# VITE_DEV_SERVER_PORT=5173
# VITE_HMR_CLIENT_PORT=5173
# VITE_HMR_HOST=localhost

# Bind-mount file watching on macOS (also CHOKIDAR_USEPOLLING=true)
# VITE_USE_POLLING=true

# Opt-in mock data for Agents MCP UI in dev (never in production builds)
# VITE_COMPANY_AGENTS_MOCK=1
